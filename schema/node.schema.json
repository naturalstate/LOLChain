{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lolchain/schema/node.schema.json",
  "title": "LolChain node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "slug", "tier", "category", "summary", "provides"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tier": { "enum": ["basic", "advanced", "expert"] },
    "category": {
      "enum": ["web", "cloud", "kubernetes", "cicd", "llm", "mobile", "network", "host", "active-directory"]
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "domains": {
      "type": "array",
      "items": { "enum": ["web", "api", "cloud", "kubernetes", "cicd", "llm", "mobile", "network", "host", "active-directory", "internal"] },
      "description": "Soft test-type tags for filtering. Defaults to [category]; bridge nodes carry several so cross-domain paths survive a single-domain view."
    },
    "summary": { "type": "string", "minLength": 10 },
    "requires": { "type": "array", "items": { "type": "string" }, "default": [] },
    "provides": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "achieves": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Goal slugs (from goals.yml) realised by reaching this node."
    },
    "detection": { "type": "string" },
    "remediation": { "type": "string" },
    "mitre": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "via", "outcome"],
        "properties": {
          "to": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "via": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "outcome": { "type": "string", "minLength": 5 },
          "tier": { "enum": ["basic", "advanced", "expert"] },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "documented": { "type": "boolean", "default": false },
          "references": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    }
  }
}
