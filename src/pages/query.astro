    }
    function restoreGraph(id) {
      const cy = cyById[id]; if (!cy) return;
      cy.scratch('_pruned', false);
      cy.elements().show().removeClass('dim hl').style('opacity', 1);
      const wrap = document.getElementById(id)?.closest('.graphwrap');
      const sa = wrap && wrap.querySelector('[data-act=showall]'); if (sa) sa.style.display = 'none';
      hideChainKey(id);
      hidePathway(id);
      runLayout(id);
    }
    // After entering OR leaving fullscreen the container size changes; the browser
    // finishes the transition asynchronously, so resize/fit a few times to catch the
    // final size (otherwise the canvas keeps the fullscreen width and overflows right).
    function refitAfterFullscreen() {
      const run = () => Object.values(cyById).forEach((cy) => {
        try { cy.resize(); if (cy.elements(':visible').length) cy.fit(undefined, 24); } catch (e) {}
      });
      requestAnimationFrame(run);
      setTimeout(run, 160);
      setTimeout(run, 420);
    }
    if (typeof document !== 'undefined') {
      document.addEventListener('fullscreenchange', refitAfterFullscreen);
      document.addEventListener('webkitfullscreenchange', refitAfterFullscreen);
    }

    // --- domain soft-filter (test-type) ---
    const DOMAIN_COLOR = { ...CAT_COLOR, api: '#9bb4c4' };
    const DOMAIN_LABEL = { 'active-directory': 'ad', kubernetes: 'k8s' };
    const enabledDomains = new Set();
    // Dim (never remove) nodes whose domains are all outside the enabled set, so a
    // single-domain view still shows the bridge nodes that carry multiple domains.
    function applyDomainFilter(cy) {
      if (!cy) return;
      cy.batch(() => {
        cy.nodes().forEach((n) => {
          const dom = n.data('dom') || [];
          const show = n.data('start') === 1 || !dom.length || !enabledDomains.size || dom.some((d) => enabledDomains.has(d));
          n.toggleClass('domdim', !show);
        });
        cy.edges().forEach((e) => {
          e.toggleClass('domdim', e.source().hasClass('domdim') || e.target().hasClass('domdim'));
        });
      });
    }
    function applyDomainFilterAll() { Object.values(cyById).forEach(applyDomainFilter); }
    function buildDomainChips() {
      const host = document.getElementById('df-chips');
      if (!host || !graph) return;
      const vocab = [...new Set(graph.nodes.flatMap((n) => n.domains ?? [n.category]))].sort();
      vocab.forEach((d) => enabledDomains.add(d));
      host.innerHTML = vocab.map((d) => {
        const c = DOMAIN_COLOR[d] ?? '#8a93a6';
        return `<button type="button" class="df-chip on" data-domain="${d}" style="--dc:${c}"><span class="df-sw"></span>${esc(DOMAIN_LABEL[d] ?? d)}</button>`;
      }).join('');
      host.querySelectorAll('.df-chip').forEach((b) => b.addEventListener('click', () => {
        const d = b.dataset.domain;
        if (enabledDomains.has(d)) { enabledDomains.delete(d); b.classList.remove('on'); }
        else { enabledDomains.add(d); b.classList.add('on'); }
        applyDomainFilterAll();
      }));
      const reset = document.getElementById('df-all');
      if (reset) reset.addEventListener('click', () => {
        vocab.forEach((d) => enabledDomains.add(d));
        host.querySelectorAll('.df-chip').forEach((b) => b.classList.add('on'));
        applyDomainFilterAll();
      });
    }

    function drawGraph(id, els, roots) {
      const container = document.getElementById(id);
      if (!container) return;
      const wrap = container.closest('.graphwrap');
      if (typeof cytoscape === 'undefined' || !els.length) { if (wrap) wrap.style.display = 'none'; return; }
      if (wrap) wrap.style.display = 'block';
      let cy = cyById[id];
      if (!cy) {
        cy = cyById[id] = cytoscape({ container, style: GRAPH_STYLE, wheelSensitivity: 0.2, minZoom: 0.15, maxZoom: 3 });
        const ctrls = wrap && wrap.querySelector('.graph-controls');
        if (ctrls) {
          const fs = document.createElement('button'); fs.type = 'button'; fs.className = 'gc'; fs.dataset.cy = id; fs.dataset.act = 'fs'; fs.title = 'Fullscreen the map'; fs.textContent = '⛶'; ctrls.appendChild(fs);
          const sa = document.createElement('button'); sa.type = 'button'; sa.className = 'gc gc-showall'; sa.dataset.cy = id; sa.dataset.act = 'showall'; sa.title = 'Restore the whole map'; sa.textContent = 'show all'; sa.style.display = 'none'; ctrls.appendChild(sa);
        }
        // context menu: "use this exploit path"
        const menu = document.createElement('div'); menu.className = 'cy-menu'; menu.style.display = 'none';
        menu.innerHTML = '<button type="button" class="cy-menu-use">⛓ use this path</button>'
          + '<button type="button" class="cy-menu-open">↗ open info in new tab</button>';
        if (wrap) wrap.appendChild(menu);
        // chain key (bottom-left: the selected/pruned chain) + node key (top-left: hovered node)
        const ckey = document.createElement('div'); ckey.className = 'cy-chainkey'; ckey.style.display = 'none';
        if (wrap) wrap.appendChild(ckey);
        const nkey = document.createElement('div'); nkey.className = 'cy-nodekey'; nkey.style.display = 'none';
        if (wrap) wrap.appendChild(nkey);
        // Keep the canvas sized to its container through fullscreen / expand / window
        // resize — this is what stops the post-fullscreen horizontal stretch.
        if (typeof ResizeObserver !== 'undefined') {
          let rt; const ro = new ResizeObserver(() => { clearTimeout(rt); rt = setTimeout(() => { try { cy.resize(); } catch (e) {} }, 90); });
          ro.observe(container);
        }
        let menuTarget = null;
        const hideMenu = () => { menu.style.display = 'none'; menuTarget = null; };
        cy.on('tap', 'node', (e) => {
          menuTarget = e.target.id();
          const p = e.target.renderedPosition();
          menu.style.left = Math.round(p.x) + 'px';
          menu.style.top = Math.round(p.y) + 'px';
          menu.style.display = 'block';
          // Brief overview of the clicked node in the sidebar; collapse inputs to make room.
          showNodeInfo(id, menuTarget);
          collapseInputs(id);
        });
        cy.on('tap', (e) => { if (e.target === cy) hideMenu(); });
        cy.on('pan zoom', hideMenu);
        menu.querySelector('.cy-menu-use').addEventListener('click', () => { if (menuTarget) pruneToPath(id, menuTarget); hideMenu(); });
        menu.querySelector('.cy-menu-open').addEventListener('click', () => { if (menuTarget) window.open(`${BASE}node/${menuTarget}/`, '_blank', 'noopener'); hideMenu(); });
        // hover: highlight the whole chain through the node (upstream AND downstream),
        // dim the rest, and show the chain as text in the top-left key. Scoped to
        // visible elements so it keeps working after a prune (repeatable).
        cy.on('mouseover', 'node', (e) => {
          const vis = cy.elements(':visible');
          const chain = e.target.union(e.target.successors()).union(e.target.predecessors()).intersection(vis);
          vis.addClass('dim');
          chain.removeClass('dim').addClass('hl');
          showNodeKey(id, e.target);
          showPathway(id, chain, false); // sidebar preview of the hovered chain
        });
        cy.on('mouseout', 'node', () => { cy.elements().removeClass('dim hl'); hideNodeKey(id); restorePathway(id); });
        if (wrap) wrap.querySelectorAll('.gc').forEach((btn) => btn.addEventListener('click', () => {
          const act = btn.dataset.act;
          const cx = container.clientWidth / 2, cyy = container.clientHeight / 2;
          if (act === 'in') cy.zoom({ level: cy.zoom() * 1.3, renderedPosition: { x: cx, y: cyy } });
          else if (act === 'out') cy.zoom({ level: cy.zoom() / 1.3, renderedPosition: { x: cx, y: cyy } });
          else if (act === 'fit') cy.fit(undefined, 24);
          else if (act === 'relayout') runLayout(id);
          else if (act === 'shuffle') { layoutIdx[id] = ((layoutIdx[id] ?? 0) + 1) % LAYOUT_ORDER.length; runLayout(id); }
          else if (act === 'fs') toggleFullscreen(wrap);
          else if (act === 'showall') restoreGraph(id);
        }));
      }
      cy.elements().remove();
      cy.add(els);
      cy.scratch('_pruned', false);
      const saBtn = wrap && wrap.querySelector('[data-act=showall]'); if (saBtn) saBtn.style.display = 'none';
      hideChainKey(id); hideNodeKey(id); hidePathway(id); hideNodeInfo(id);
      cy.resize();
      lastRoots[id] = roots?.length ? roots : null;
      if (layoutIdx[id] === undefined) layoutIdx[id] = 0;
      runLayout(id);
      applyDomainFilter(cy);
    }

    function focusNode(id, slug) {
      const cy = cyById[id];
      if (!cy) return;
      const node = cy.getElementById(slug);
      if (!node || !node.length) return;
      cy.nodes().removeClass('focus');
      node.addClass('focus');
      cy.animate({ center: { eles: node }, zoom: Math.max(cy.zoom(), 1.1) }, { duration: 300 });
    }

    function pushNode(els, seen, slug, extra = {}) {
      if (seen.has(slug)) return; seen.add(slug);
      const n = nodeMeta[slug];
      els.push({ data: { id: slug, label: n.name, cat: n.category, dom: n.domains ?? [n.category], goal: (n.achieves ?? []).length ? 1 : 0, ...extra } });
    }
    function pathElements(paths) {
      const seen = new Set(), eseen = new Set(), els = [];
      for (const p of paths) {
        p.nodes.forEach((s) => pushNode(els, seen, s));
        p.edges.forEach((e) => {
          const id = `${e.from}>${e.to}`;
          if (eseen.has(id)) return; eseen.add(id);
          els.push({ data: { id, source: e.from, target: e.to, via: e.via.map((v) => capLabel[v] ?? v).join(', '), curated: e.type === 'curated' ? 1 : 0 } });
        });
      }
      return els;
    }

    // --- shared path renderer ---
    function pathCard(p, goalSet) {
      const steps = p.nodes.map((slug, i) => {
        const n = nodeMeta[slug];
        const isGoalEnd = i === p.nodes.length - 1 && (n.achieves ?? []).some((g) => goalSet.has(g));
        let h = `<a class="step ${isGoalEnd ? 'goal' : ''}" href="${BASE}node/${slug}/">${esc(n.name)}</a>`;
        if (i < p.edges.length) {
          const e = p.edges[i];
          const via = e.via.map((v) => capLabel[v] ?? v).join(', ');
          h += `<span class="arrow ${e.type === 'curated' ? '' : 'derived'}"><span class="via">${esc(via)}</span><span class="glyph">▶</span></span>`;
        }
        return h;
      }).join('');
      const cls = p.documented ? 'documented' : (p.allCurated ? '' : 'partial');
      const tag = p.documented
        ? '<span class="chip doc">documented</span>'
        : (p.allCurated ? '<span class="chip">curated</span>' : '<span class="chip derived">includes derived</span>');
      const incomplete = p.complete === false ? '<span class="chip derived">partial</span>' : '';
      return `<div class="pathcard ${cls}"><div class="pathmeta">${tag}${incomplete}<span class="len">${p.length} hop(s)</span></div><div class="pathflow">${steps}</div></div>`;
    }

    // --- forward mode ---
    const PRIVESC_GOALS = new Set(['privilege-escalation', 'domain-admin', 'cluster-admin']);
    const fState = { node: '', caps: new Set(), privescOnly: false };
    function renderForward() {
      const summary = document.getElementById('f-summary');
      const goalsEl = document.getElementById('f-goals');
      const results = document.getElementById('f-results');
      if (!graph || (!fState.node && !fState.caps.size)) {
        summary.textContent = 'Pick a starting point to trace chains.'; goalsEl.innerHTML = ''; results.innerHTML = '';
        drawGraph('f-graph', [], []); return;
      }
      const out = forwardReach(graph, { startNodes: fState.node ? [fState.node] : [], startCaps: [...fState.caps] });
      const label = fState.node ? nodeMeta[fState.node].name : ([...fState.caps].map((c) => capLabel[c]).join(' + ') || 'an unauthenticated start');
      let uGoals = [...new Set(out.goalsReached.map((g) => g.goal))];
      // Privilege-escalation-only: keep just the escalation end-states and the nodes that reach them.
      const escList = fState.privescOnly
        ? out.activated.filter((r) => (nodeMeta[r.slug].achieves ?? []).some((g) => PRIVESC_GOALS.has(g)))
        : out.activated;
      if (fState.privescOnly) uGoals = uGoals.filter((g) => PRIVESC_GOALS.has(g));
      summary.innerHTML = fState.privescOnly
        ? `From <b>${esc(label)}</b>: <b>${escList.length}</b> privilege-escalation step(s), reaching <b>${uGoals.length}</b> escalation goal(s).`
        : `From <b>${esc(label)}</b> you can reach <b>${out.activated.length}</b> vuln(s) and <b>${uGoals.length}</b> goal(s).`;
      goalsEl.innerHTML = uGoals.map((g) => `<span class="chip goal">${esc(goalLabel[g] ?? g)}</span>`).join('');

      // graph
      const gseen = new Set(), gedge = new Set(), gels = [];
      let rootId = null;
      if (fState.node) pushNode(gels, gseen, fState.node, { start: 1 });
      else { rootId = '__held'; gels.push({ data: { id: rootId, label: label || 'held caps', cat: 'start', start: 1 } }); }
      for (const r of out.activated) {
        pushNode(gels, gseen, r.slug);
        if (r.predecessors.length) {
          for (const pr of r.predecessors) {
            const eid = `${pr.node}>${r.slug}`;
            if (gedge.has(eid)) continue; gedge.add(eid);
            pushNode(gels, gseen, pr.node);
            gels.push({ data: { id: eid, source: pr.node, target: r.slug, via: capLabel[pr.cap] ?? pr.cap, curated: r.curated ? 1 : 0 } });
          }
        } else {
          const src = fState.node || rootId;
          const eid = `${src}>${r.slug}`;
          if (!gedge.has(eid)) { gedge.add(eid); gels.push({ data: { id: eid, source: src, target: r.slug, via: '', curated: r.curated ? 1 : 0 } }); }
        }
      }
      drawGraph('f-graph', gels, [fState.node || rootId]);

      if (!out.activated.length) { results.innerHTML = '<div class="q-empty">Terminal node — nothing chains onward.</div>'; return; }
      if (!escList.length) { results.innerHTML = '<div class="q-empty">No privilege-escalation step from this start. Turn off “privilege-escalation only” to see every reachable chain.</div>'; return; }
      const byDepth = {};
      for (const r of escList) (byDepth[r.depth] ??= []).push(r);
      let html = '';
      for (const d of Object.keys(byDepth).sort((a, b) => a - b)) {
        html += `<div class="hopgroup"><div class="hophead">Hop ${d}</div>`;
        for (const r of byDepth[d]) {
          const n = nodeMeta[r.slug];
          const via = r.viaCaps.map((c) => `<span class="chip cap">${esc(capLabel[c] ?? c)}</span>`).join('');
          const preds = [...new Set(r.predecessors.map((p) => p.node))].map((p) => nodeMeta[p]?.name ?? p);
          const from = preds.length ? `from ${esc(preds.join(', '))}` : 'from held capabilities';
          const tag = r.curated ? '<span class="chip doc">documented</span>' : '<span class="chip derived">derived · unverified</span>';
          const goals = (n.achieves ?? []).map((g) => `<span class="chip goal">${esc(goalLabel[g] ?? g)}</span>`).join('');
          const outcome = r.curated && r.outcome ? `<div class="rout">${esc(r.outcome)}</div>` : '';
          html += `<a class="res ${r.curated ? '' : 'derived'}" href="${BASE}node/${r.slug}/"><div class="rhead"><span class="rname">${esc(n.name)}</span><span class="chip tier-${n.tier}">${n.tier}</span><span class="cat">${n.category}</span>${goals}</div><div class="rvia"><span class="label">via</span>${via}${tag}</div><div class="rfrom">${from}</div>${outcome}</a>`;
        }
        html += '</div>';
      }
