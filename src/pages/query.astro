    }

    // --- goal-directed mode ---
    const gState = { node: '', goal: '', through: '' };
    // Disable goals/throughs that can't be reached from the chosen start, so the
    // user never has to click through an impossible combination to discover it's empty.
    function syncGoalAvail() {
      const start = gState.node ? nodeMeta[gState.node] : null;
      const goalSel = document.getElementById('g-goal');
      const thruSel = document.getElementById('g-through');
      const canGoal = (slug) => !start || (start.reachGoals ?? []).includes(slug) || (start.achieves ?? []).includes(slug);
      for (const opt of goalSel.options) { if (opt.value) opt.disabled = !canGoal(opt.value); }
      if (gState.goal && !canGoal(gState.goal)) { gState.goal = ''; goalSel.value = ''; }

      const goal = gState.goal;
      const canThru = (slug) => {
        if (!start) return true;
        if (slug === gState.node) return false;
        if (!(start.reachNodes ?? []).includes(slug)) return false;
        if (!goal) return true;
        const tn = nodeMeta[slug];
        return (tn.reachGoals ?? []).includes(goal) || (tn.achieves ?? []).includes(goal);
      };
      for (const opt of thruSel.options) { if (opt.value) opt.disabled = !canThru(opt.value); }
      if (gState.through && !canThru(gState.through)) { gState.through = ''; thruSel.value = ''; }
    }
    function renderGoal() {
      const summary = document.getElementById('g-summary');
      const results = document.getElementById('g-results');
      if (!graph || !gState.node || !gState.goal) {
        summary.textContent = 'Pick a start vuln and a goal.'; results.innerHTML = '';
        drawGraph('g-graph', [], []); return;
      }
      const paths = findPaths(graph, { start: gState.node, goalSlugs: [gState.goal], through: gState.through || null, maxDepth: 6 });
      const goalSet = new Set([gState.goal]);
      const thru = gState.through ? ` through <b>${esc(nodeMeta[gState.through].name)}</b>` : '';
      summary.innerHTML = `<b>${paths.length}</b> path(s) from <b>${esc(nodeMeta[gState.node].name)}</b> to <b>${esc(goalLabel[gState.goal])}</b>${thru}.`;
      results.innerHTML = paths.length
        ? paths.map((p) => pathCard(p, goalSet)).join('')
        : '<div class="q-empty">No path within 6 hops. Try removing the "through" constraint, or a different start — curated multi-hop chains are sparse by design.</div>';
      drawGraph('g-graph', pathElements(paths), gState.node ? [gState.node] : undefined);
    }

    // --- backward mode ---
    const bState = { goal: '' };
    function renderBackward() {
      const summary = document.getElementById('b-summary');
      const results = document.getElementById('b-results');
      if (!graph || !bState.goal) {
        summary.textContent = 'Pick a goal to see what gives it and what each step needs.'; results.innerHTML = '';
        drawGraph('b-graph', [], []); return;
      }
      const achievers = nodesAchieving(graph, [bState.goal]);
      const res = findBackward(graph, { goalSlugs: [bState.goal], maxDepth: 6 });
      const goalSet = new Set([bState.goal]);
      summary.innerHTML = `<b>${esc(goalLabel[bState.goal])}</b> is achieved by <b>${achievers.length}</b> vuln(s). Every one is on the map; entry paths below.`;

      // Map: all backward paths, PLUS every achiever (even those with no inbound path).
      const els = pathElements(res);
      const present = new Set(els.filter((e) => e.data.source === undefined).map((e) => e.data.id));
      const seen = present;
      for (const gn of achievers) pushNode(els, seen, gn);
      drawGraph('b-graph', els, undefined);

      const byGoalNode = {};
      for (const r of res) (byGoalNode[r.goalNode] ??= []).push(r);
      let html = '';
      for (const gn of achievers) {
        const list = byGoalNode[gn] ?? [];
        const n = nodeMeta[gn];
        html += `<div class="goal-node-head" data-focus="${gn}" title="Centre on map">achieved by <b>${esc(n.name)}</b> <span class="cat">${esc(n.category)}</span><span class="focus-hint">◎ map</span></div>`;
        html += list.length ? list.map((p) => pathCard(p, goalSet)).join('')
          : `<div class="pathcard"><div class="pathmeta"><span class="chip">entry point</span></div><div class="pathflow"><a class="step goal" href="${BASE}node/${gn}/">${esc(n.name)}</a></div></div>`;
      }
      results.innerHTML = html;
      results.querySelectorAll('[data-focus]').forEach((el) => el.addEventListener('click', () => focusNode('b-graph', el.dataset.focus)));
    }

    // --- simple mode (one search box -> ranked results -> drill-down) ---
    const simpleState = { trail: [], typeFilter: null, lastQuery: '' };
    let simpleIndex = [], succMap = {}, predMap = {};
    const KIND_LABEL = { node: 'vulns', goal: 'goals', cap: 'capabilities' };
    const KIND_TAG = { node: 'vuln', goal: 'goal', cap: 'capability' };
    const SIMPLE_HINT = '<div class="simple-hint">Type to search 92 techniques, 11 goals, and every capability hand-off. Click a result to drill into what reaches it and where it leads.</div>';

    function buildSimpleIndex() {
      simpleIndex = [];
      for (const n of graph.nodes) simpleIndex.push({ kind: 'node', slug: n.slug, label: n.name, cat: n.category, tier: n.tier,
        hay: [n.name, ...(n.aliases ?? []), n.category, n.os ?? '', n.summary ?? ''].join(' ').toLowerCase() });
      for (const g of graph.goals) simpleIndex.push({ kind: 'goal', slug: g.slug, label: g.label, hay: [g.label, g.description ?? '', g.slug].join(' ').toLowerCase() });
      for (const c of graph.capabilities) simpleIndex.push({ kind: 'cap', slug: c.slug, label: c.label, hay: [c.label, c.description ?? '', c.slug].join(' ').toLowerCase() });
      succMap = {}; predMap = {};
      for (const e of graph.edges) {
        (succMap[e.from] ??= []).push({ slug: e.to, via: e.via, type: e.type });
        (predMap[e.to] ??= []).push({ slug: e.from, via: e.via, type: e.type });
      }
    }
    function scoreEntry(entry, q) {
      const label = entry.label.toLowerCase();
      if (label === q) return 100;
      if (label.startsWith(q)) return 80;
      if (new RegExp('\\b' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).test(label)) return 60;
      if (label.includes(q)) return 45;
      if (entry.hay.includes(q)) return 25;
      return 0;
    }
    function runSimpleSearch(raw) {
      const clarify = document.getElementById('s-clarify');
      const crumbs = document.getElementById('s-crumbs');
      const results = document.getElementById('s-results');
      simpleState.trail = []; crumbs.hidden = true; simpleState.lastQuery = raw;
      let q = (raw ?? '').trim().toLowerCase();
      if (!q) { clarify.hidden = true; results.innerHTML = SIMPLE_HINT; return; }
      // Light intent parsing: "I want X" biases goals, "I have X" biases capabilities.
      let boost = null;
      if (/^i? ?want /.test(q)) { boost = 'goal'; q = q.replace(/^i? ?want /, '').trim(); }
      else if (/^i? ?have /.test(q)) { boost = 'cap'; q = q.replace(/^i? ?have /, '').trim(); }
      if (!q) { clarify.hidden = true; results.innerHTML = SIMPLE_HINT; return; }
      let scored = simpleIndex.map((e) => ({ e, s: scoreEntry(e, q) + (boost === e.kind ? 15 : 0) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s);
      if (simpleState.typeFilter) scored = scored.filter((x) => x.e.kind === simpleState.typeFilter);
      // "Ask only when needed": offer type chips only when the top matches span kinds.
      const kinds = [...new Set(scored.slice(0, 20).map((x) => x.e.kind))];
      if (simpleState.typeFilter) {
        clarify.hidden = false;
        clarify.innerHTML = `<span class="sc-q">Showing ${KIND_LABEL[simpleState.typeFilter]} only</span><button type="button" class="sc-chip sc-clear">clear ✕</button>`;
        clarify.querySelector('.sc-clear').addEventListener('click', () => { simpleState.typeFilter = null; runSimpleSearch(raw); });
      } else if (kinds.length > 1) {
        clarify.hidden = false;
        clarify.innerHTML = '<span class="sc-q">Narrow to:</span>' + kinds.map((k) => `<button type="button" class="sc-chip" data-k="${k}">${KIND_LABEL[k]}</button>`).join('');
        clarify.querySelectorAll('.sc-chip').forEach((b) => b.addEventListener('click', () => { simpleState.typeFilter = b.dataset.k; runSimpleSearch(raw); }));
      } else { clarify.hidden = true; }
      if (!scored.length) { results.innerHTML = '<div class="simple-empty">No match. Try a vuln name, a capability, or a goal.</div>'; return; }
      results.innerHTML = scored.slice(0, 12).map((x) => resultRow(x.e)).join('');
      results.querySelectorAll('.sr-row').forEach((b) => b.addEventListener('click', () => {
        if (b.dataset.kind === 'node') drillNode(b.dataset.slug, true); else drillCapGoal(b.dataset.kind, b.dataset.slug);
      }));
    }
    function resultRow(e) {
      const meta = e.kind === 'node'
        ? `<span class="sr-cat" style="color:${CAT_COLOR[e.cat] ?? '#8a93a6'}">${esc(e.cat)}</span><span class="chip tier-${esc(e.tier)}">${esc(e.tier)}</span>`
        : '';
      return `<button type="button" class="sr-row" data-kind="${e.kind}" data-slug="${esc(e.slug)}"><span class="sr-kind k-${e.kind}">${KIND_TAG[e.kind]}</span><span class="sr-label">${esc(e.label)}</span>${meta}<span class="sr-go">›</span></button>`;
    }
    function stepButtons(arr) {
      const real = (arr ?? []).filter((p) => nodeMeta[p.slug]);
      if (!real.length) return '<span class="ni-none">—</span>';
      return real.map((p) => {
        const n = nodeMeta[p.slug];
        const via = (p.via ?? []).map((v) => capLabel[v] ?? v).join(', ');
        return `<button type="button" class="sd-step" data-slug="${esc(p.slug)}"><span class="sd-dot" style="background:${CAT_COLOR[n.category] ?? '#8a93a6'}"></span><span class="sd-sname">${esc(n.name)}</span>${via ? `<span class="sd-via">${esc(via)}</span>` : ''}</button>`;
      }).join('');
    }
    function nodeMini(n) {
      return `<button type="button" class="sd-step" data-slug="${esc(n.slug)}"><span class="sd-dot" style="background:${CAT_COLOR[n.category] ?? '#8a93a6'}"></span><span class="sd-sname">${esc(n.name)}</span><span class="sd-via">${esc(n.category)}</span></button>`;
    }
    function renderCrumbs(leadLabel) {
      const crumbs = document.getElementById('s-crumbs');
      const items = ['<button type="button" class="crumb home">⌕ back to search</button>'];
      if (leadLabel) items.push(`<span class="crumb lead">${esc(leadLabel)}</span>`);
      simpleState.trail.forEach((s, i) => items.push(`<button type="button" class="crumb" data-i="${i}">${esc(nodeMeta[s]?.name ?? s)}</button>`));
      crumbs.hidden = items.length <= 1;
      crumbs.innerHTML = items.join('<span class="crumb-sep">›</span>');
      crumbs.querySelector('.home').addEventListener('click', () => { const el = document.getElementById('s-input'); el.focus(); runSimpleSearch(el.value); });
      crumbs.querySelectorAll('.crumb[data-i]').forEach((b) => b.addEventListener('click', () => {
        const i = +b.dataset.i, slug = simpleState.trail[i];
        simpleState.trail = simpleState.trail.slice(0, i); drillNode(slug, false);
      }));
    }
    function drillNode(slug, reset) {
      const n = nodeMeta[slug]; if (!n) return;
      if (reset) simpleState.trail = [];
      if (simpleState.trail[simpleState.trail.length - 1] !== slug) simpleState.trail.push(slug);
      renderCrumbs();
      const chip = (arr, labeler, cls) => (arr && arr.length) ? arr.map((x) => `<span class="chip ${cls}">${esc(labeler(x))}</span>`).join('') : '<span class="ni-none">—</span>';
      const goals = (n.reachGoals && n.reachGoals.length) ? n.reachGoals : (n.achieves ?? []);
      document.getElementById('s-clarify').hidden = true;
      document.getElementById('s-results').innerHTML =
        `<div class="sd-card"><div class="sd-head"><span class="ni-dot" style="background:${CAT_COLOR[n.category] ?? '#8a93a6'}"></span>`
        + `<span class="sd-name">${esc(n.name)}</span><span class="chip tier-${esc(n.tier)}">${esc(n.tier)}</span><span class="sr-cat">${esc(n.category)}</span>${n.os ? `<span class="sr-cat">${esc(n.os)}</span>` : ''}</div>`
        + `<p class="sd-sum">${esc((n.summary ?? '').trim())}</p>`
        + `<div class="sd-grid"><div class="sd-col"><div class="sd-lab">↑ reached by</div>${stepButtons(predMap[slug])}</div>`
        + `<div class="sd-col"><div class="sd-lab">↓ leads to</div>${stepButtons(succMap[slug])}</div></div>`
        + `<div class="sd-row"><span class="ni-lab">requires</span>${chip(n.requires, (c) => capLabel[c] ?? c, 'cap')}</div>`
        + `<div class="sd-row"><span class="ni-lab">provides</span>${chip(n.provides, (c) => capLabel[c] ?? c, 'cap')}</div>`
        + `<div class="sd-row"><span class="ni-lab">reaches</span>${chip(goals, (g) => goalLabel[g] ?? g, 'goal')}</div>`
        + `<a class="ni-open" href="${BASE}node/${slug}/" target="_blank" rel="noopener">open full page ↗</a></div>`;
      document.querySelectorAll('#s-results .sd-step').forEach((b) => b.addEventListener('click', () => drillNode(b.dataset.slug, false)));
    }
    function drillCapGoal(kind, slug) {
      simpleState.trail = [];
      renderCrumbs(kind === 'goal' ? goalLabel[slug] : capLabel[slug]);
      document.getElementById('s-clarify').hidden = true;
      let body = '';
      if (kind === 'goal') {
        const ach = graph.nodes.filter((n) => (n.achieves ?? []).includes(slug));
        const reach = graph.nodes.filter((n) => !(n.achieves ?? []).includes(slug) && (n.reachGoals ?? []).includes(slug));
        body = `<div class="sd-group"><div class="sd-lab">achieved directly by ${ach.length}</div>${ach.map(nodeMini).join('') || '<span class="ni-none">—</span>'}</div>`
          + `<div class="sd-group"><div class="sd-lab">reaches it through a chain · ${reach.length}</div>${reach.slice(0, 24).map(nodeMini).join('') || '<span class="ni-none">—</span>'}</div>`;
      } else {
        const prov = graph.nodes.filter((n) => (n.provides ?? []).includes(slug));
        const req = graph.nodes.filter((n) => (n.requires ?? []).includes(slug));
        body = `<div class="sd-group"><div class="sd-lab">provided by ${prov.length}</div>${prov.map(nodeMini).join('') || '<span class="ni-none">—</span>'}</div>`
          + `<div class="sd-group"><div class="sd-lab">required by ${req.length}</div>${req.map(nodeMini).join('') || '<span class="ni-none">—</span>'}</div>`;
      }
      document.getElementById('s-results').innerHTML =
        `<div class="sd-card"><div class="sd-head"><span class="sr-kind k-${kind}">${KIND_TAG[kind]}</span><span class="sd-name">${esc(kind === 'goal' ? goalLabel[slug] : capLabel[slug])}</span></div>${body}</div>`;
      document.querySelectorAll('#s-results .sd-step').forEach((b) => b.addEventListener('click', () => drillNode(b.dataset.slug, true)));
    }

    // --- wiring ---
    function wire() {
      const wrapEl = document.getElementById('q-wrap');
      const vt = document.getElementById('view-toggle');
      if (vt) vt.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        vt.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
        b.classList.add('on');
        wrapEl.classList.toggle('q-expanded', b.dataset.view === 'expanded');
        try { localStorage.setItem('lc-view', b.dataset.view); } catch (e) {}
        setTimeout(resizeAllGraphs, 70);
      }));
      const rail = document.getElementById('rail-toggle');
      if (rail) rail.addEventListener('click', () => {
        const c = wrapEl.classList.toggle('rail-collapsed');
        rail.textContent = c ? '⟩ panel' : '⟨ panel';
        setTimeout(resizeAllGraphs, 70);
      });
      try { if (localStorage.getItem('lc-view') === 'expanded') document.querySelector('#view-toggle [data-view=expanded]')?.click(); } catch (e) {}

      document.querySelectorAll('.tab').forEach((t) => t.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
        document.querySelectorAll('.panel').forEach((x) => x.classList.remove('active'));
        t.classList.add('active');
        document.getElementById('panel-' + t.dataset.tab).classList.add('active');
        // Simple mode has no map; hide the map-only controls (viewbar/legend/scope).
        wrapEl.classList.toggle('simple-active', t.dataset.tab === 'simple');
        if (t.dataset.tab === 'simple') { setTimeout(() => document.getElementById('s-input')?.focus(), 0); return; }
        // Cytoscape needs a resize+fit after its container becomes visible.
        const g = { forward: 'f-graph', goal: 'g-graph', backward: 'b-graph' }[t.dataset.tab];
        const cy = cyById[g];
        if (cy && cy.elements().length) { cy.resize(); cy.fit(undefined, 24); }
      }));

      const sInput = document.getElementById('s-input');
      if (sInput) { let sT; sInput.addEventListener('input', () => { clearTimeout(sT); sT = setTimeout(() => { simpleState.typeFilter = null; runSimpleSearch(sInput.value); }, 110); }); }

      const syncCapPicks = () => document.querySelectorAll('#panel-forward .pick').forEach((b) =>
        b.classList.toggle('sel', fState.caps.has(b.dataset.cap)));

      // Phase 2: collapsible forward input sections (collapse on choice, click header to reopen).
      const fGroup = (name) => document.querySelector(`#f-controls [data-group="${name}"]`);
      const setSummary = (name, text) => { const g = fGroup(name); if (g) { const s = g.querySelector('.gsummary'); if (s) s.textContent = text || ''; } };
      const collapseGroup = (name, val) => { const g = fGroup(name); if (g) g.classList.toggle('collapsed', val); };
      const updCapsSummary = () => setSummary('caps', fState.caps.size ? `${fState.caps.size} selected` : '');
      document.querySelectorAll('#f-controls .control-group.collapsible .ghead').forEach((h) =>
        h.addEventListener('click', () => h.closest('.control-group').classList.toggle('collapsed')));

      document.getElementById('f-node').addEventListener('change', (e) => {
        fState.node = e.target.value;
        const txt = e.target.selectedOptions[0]?.textContent?.trim();
        setSummary('vuln', e.target.value ? txt : '');
        collapseGroup('vuln', !!e.target.value);
        renderForward();
      });
      document.querySelectorAll('#panel-forward .pick').forEach((b) => b.addEventListener('click', () => {
        const c = b.dataset.cap;
        if (fState.caps.has(c)) { fState.caps.delete(c); b.classList.remove('sel'); } else { fState.caps.add(c); b.classList.add('sel'); }
        document.querySelectorAll('#panel-forward .posture').forEach((p) => p.classList.remove('sel'));
        setSummary('posture', '');
        updCapsSummary();
        renderForward();
      }));
      // Start posture: seed an assume-breach capability bundle, clear any node start.
      document.querySelectorAll('#panel-forward .posture').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('#panel-forward .posture').forEach((p) => p.classList.remove('sel'));
        b.classList.add('sel');
        fState.node = ''; document.getElementById('f-node').value = '';
        fState.caps = new Set((b.dataset.caps || '').split(',').filter(Boolean));
        syncCapPicks();
        setSummary('posture', b.textContent.trim());
        setSummary('vuln', '');
        updCapsSummary();
        collapseGroup('posture', true);
        renderForward();
      }));
      document.getElementById('f-privesc').addEventListener('change', (e) => { fState.privescOnly = e.target.checked; renderForward(); });
      document.getElementById('f-reset').addEventListener('click', () => {
        fState.node = ''; fState.caps.clear(); fState.privescOnly = false;
        document.getElementById('f-node').value = '';
        document.getElementById('f-privesc').checked = false;
        document.querySelectorAll('#panel-forward .pick.sel').forEach((b) => b.classList.remove('sel'));
        document.querySelectorAll('#panel-forward .posture').forEach((p, i) => p.classList.toggle('sel', i === 0));
        ['posture', 'vuln', 'caps'].forEach((n) => { setSummary(n, ''); collapseGroup(n, false); });
        hideNodeInfo('f-graph'); hidePathway('f-graph');
        renderForward();
      });

      document.getElementById('g-node').addEventListener('change', (e) => { gState.node = e.target.value; syncGoalAvail(); renderGoal(); });
      document.getElementById('g-goal').addEventListener('change', (e) => { gState.goal = e.target.value; syncGoalAvail(); renderGoal(); });
      document.getElementById('g-through').addEventListener('change', (e) => { gState.through = e.target.value; renderGoal(); });
      document.getElementById('g-reset').addEventListener('click', () => {
        gState.node = gState.goal = gState.through = '';
        ['g-node', 'g-goal', 'g-through'].forEach((id) => (document.getElementById(id).value = ''));
        syncGoalAvail(); renderGoal();
      });

      document.getElementById('b-goal').addEventListener('change', (e) => { bState.goal = e.target.value; renderBackward(); });
    }

    fetch(`${BASE}graph.json`).then((r) => r.json()).then((g) => {
      graph = g;
      capLabel = Object.fromEntries(g.capabilities.map((c) => [c.slug, c.label]));
      goalLabel = Object.fromEntries(g.goals.map((x) => [x.slug, x.label]));
      nodeMeta = Object.fromEntries(g.nodes.map((n) => [n.slug, n]));
      buildDomainChips();
      buildSimpleIndex();
      wire();
    });
  </script>
</Base>
