---
import Base from '../layouts/Base.astro';
import { buildGraph } from '../lib/graph.mjs';

const { nodes, capabilities, capabilityGroups, goals } = buildGraph();
const nodeChoices = [...nodes].sort((a, b) => a.name.localeCompare(b.name));
const goalChoices = [...goals].sort((a, b) => a.label.localeCompare(b.label));
const capGroups = capabilityGroups.map((g) => ({ ...g, caps: capabilities.filter((c) => c.group === g.id) }));
---
<Base title="Query" description="Tell LolChain what you have or want; see the chains between.">
  <div class="wrap" id="q-wrap">
    <section class="hero" style="padding-bottom:10px">
      <div class="label kicker">Query engine</div>
      <h1 style="font-size:clamp(28px,4.5vw,44px)">Trace the chains.</h1>
    </section>

    <div class="tabs">
      <button class="tab active" data-tab="forward">I have X</button>
      <button class="tab" data-tab="goal">X → goal Z</button>
      <button class="tab" data-tab="backward">I want Z</button>
      <button class="tab" data-tab="simple">Simple</button>
    </div>

    <div class="q-viewbar">
      <div class="view-toggle" id="view-toggle">
        <button type="button" data-view="standard" class="on">Standard</button>
        <button type="button" data-view="expanded">Expanded</button>
      </div>
      <button type="button" class="vbtn" id="rail-toggle" title="Collapse the controls panel for a wider map">⟨ panel</button>
    </div>

    <div class="graph-legend">
      <span class="lg"><span class="sw" style="background:#4ea1d3"></span>web</span>
      <span class="lg"><span class="sw" style="background:#d9a441"></span>cloud</span>
      <span class="lg"><span class="sw" style="background:#56b877"></span>k8s</span>
      <span class="lg"><span class="sw" style="background:#e5484d"></span>cicd</span>
      <span class="lg"><span class="sw" style="background:#a06cd5"></span>llm</span>
      <span class="lg"><span class="sw" style="background:#3fb6b2"></span>mobile</span>
      <span class="lg"><span class="sw" style="background:#8a93a6"></span>network</span>
      <span class="lg"><span class="sw" style="background:#cf8e6d"></span>host</span>
      <span class="lg"><span class="sw" style="background:#e26fb0"></span>ad</span>
      <span class="lg"><span class="ln"></span>curated</span>
      <span class="lg"><span class="ln dash"></span>derived</span>
      <span class="lg"><span class="sw" style="background:transparent;border:2px solid #e5484d"></span>goal</span>
    </div>

    <div class="domain-filter" id="domain-filter">
      <span class="df-label">Test scope</span>
      <div class="df-chips" id="df-chips"></div>
      <button class="df-all" id="df-all" type="button">reset</button>
    </div>

    <!-- FORWARD -->
    <div class="panel active" id="panel-forward">
      <div class="mode-layout">
        <aside class="controls" id="f-controls">
          <div class="control-group collapsible" data-group="posture">
            <button class="ghead" type="button"><span class="label">Start posture</span><span class="gsummary"></span><span class="gchevron">▾</span></button>
            <div class="gbody">
              <div class="posture-pick">
                <button class="posture sel" type="button" data-caps="">Unauthenticated external</button>
                <button class="posture" type="button" data-caps="internal-network-reach">Network foothold</button>
                <button class="posture" type="button" data-caps="domain-credentials">Assumed breach — domain user</button>
                <button class="posture" type="button" data-caps="priv-esc,os-command-exec">Assumed breach — local admin</button>
                <button class="posture" type="button" data-caps="cloud-credentials">Assumed breach — low-priv cloud</button>
              </div>
              <label class="privesc-toggle"><input type="checkbox" id="f-privesc" /> <span>Privilege-escalation only</span></label>
              <p class="control-hint">Postures seed the capabilities an assumed-breach test starts with. “Privilege-escalation only” filters results to the escalation steps (priv-esc, domain / cluster admin).</p>
            </div>
          </div>
          <div class="control-group collapsible" data-group="vuln">
            <button class="ghead" type="button"><span class="label">Start from a vuln</span><span class="gsummary"></span><span class="gchevron">▾</span></button>
            <div class="gbody">
              <select id="f-node">
                <option value="">— none —</option>
                {nodeChoices.map((n) => <option value={n.slug}>{n.name}</option>)}
              </select>
            </div>
          </div>
          <div class="control-group collapsible" data-group="caps">
            <button class="ghead" type="button"><span class="label">…or capabilities you hold</span><span class="gsummary"></span><span class="gchevron">▾</span></button>
            <div class="gbody">
              {capGroups.map((g) => g.caps.length > 0 && (
                <>
                  <div class="cap-sub">{g.label}</div>
                  <div class="chip-pick">
                    {g.caps.map((c) => <button class="pick" type="button" data-cap={c.slug} title={c.description}>{c.label}</button>)}
                  </div>
                </>
              ))}
            </div>
          </div>
          <div class="btn-row"><button class="btn" id="f-reset" type="button">Reset</button></div>
          <div class="node-info" id="f-info" hidden></div>
          <div class="pathway-list" id="f-pathway" hidden></div>
        </aside>
        <section>
          <div class="q-summary" id="f-summary">Pick a starting point to trace chains.</div>
          <div class="q-goals" id="f-goals"></div>
          <div class="graphwrap" id="f-graphwrap" style="display:none">
            <div class="graph-controls">
              <button type="button" class="gc" data-cy="f-graph" data-act="in" title="Zoom in">+</button>
              <button type="button" class="gc" data-cy="f-graph" data-act="out" title="Zoom out">−</button>
              <button type="button" class="gc" data-cy="f-graph" data-act="fit" title="Fit to contents">fit</button>
              <button type="button" class="gc" data-cy="f-graph" data-act="relayout" title="Re-run layout">↻</button>
              <button type="button" class="gc" data-cy="f-graph" data-act="shuffle" title="Different arrangement">⇄</button>
            </div>
            <div id="f-graph" class="graphbox"></div>
          </div>
          <div id="f-results"></div>
        </section>
      </div>
    </div>

    <!-- GOAL-DIRECTED -->
    <div class="panel" id="panel-goal">
      <div class="mode-layout">
        <aside class="controls">
          <div class="control-group">
            <div class="ghead"><span class="label">Start from a vuln</span></div>
            <select id="g-node"><option value="">— pick —</option>{nodeChoices.map((n) => <option value={n.slug}>{n.name}</option>)}</select>
          </div>
          <div class="control-group">
            <div class="ghead"><span class="label">Goal</span></div>
            <select id="g-goal"><option value="">— pick —</option>{goalChoices.map((g) => <option value={g.slug}>{g.label}</option>)}</select>
          </div>
          <div class="control-group">
            <div class="ghead"><span class="label">Through (optional)</span></div>
            <select id="g-through"><option value="">— any —</option>{nodeChoices.map((n) => <option value={n.slug}>{n.name}</option>)}</select>
          </div>
          <p class="control-hint">Greyed-out goals and “through” vulns can't be reached from the chosen start — the graph only links steps that actually hand off a capability, so an impossible combination is disabled rather than returning an empty map.</p>
          <div class="btn-row"><button class="btn" id="g-reset" type="button">Reset</button></div>
          <div class="node-info" id="g-info" hidden></div>
          <div class="pathway-list" id="g-pathway" hidden></div>
        </aside>
        <section>
          <div class="q-summary" id="g-summary">Pick a start vuln and a goal.</div>
          <div class="graphwrap" id="g-graphwrap" style="display:none">
            <div class="graph-controls">
              <button type="button" class="gc" data-cy="g-graph" data-act="in" title="Zoom in">+</button>
              <button type="button" class="gc" data-cy="g-graph" data-act="out" title="Zoom out">−</button>
              <button type="button" class="gc" data-cy="g-graph" data-act="fit" title="Fit to contents">fit</button>
              <button type="button" class="gc" data-cy="g-graph" data-act="relayout" title="Re-run layout">↻</button>
              <button type="button" class="gc" data-cy="g-graph" data-act="shuffle" title="Different arrangement">⇄</button>
            </div>
            <div id="g-graph" class="graphbox"></div>
          </div>
          <div id="g-results"></div>
        </section>
      </div>
    </div>

    <!-- BACKWARD -->
    <div class="panel" id="panel-backward">
      <div class="mode-layout">
        <aside class="controls">
          <div class="control-group">
            <div class="ghead"><span class="label">I want to achieve</span></div>
            <select id="b-goal"><option value="">— pick —</option>{goalChoices.map((g) => <option value={g.slug}>{g.label}</option>)}</select>
          </div>
          <p class="control-hint">The map shows <b>every</b> vuln that reaches this goal and the entry paths into each. Click a result to centre it on the map.</p>
          <div class="node-info" id="b-info" hidden></div>
          <div class="pathway-list" id="b-pathway" hidden></div>
        </aside>
        <section>
          <div class="q-summary" id="b-summary">Pick a goal to see what gives it and what each step needs.</div>
          <div class="graphwrap" id="b-graphwrap" style="display:none">
            <div class="graph-controls">
              <button type="button" class="gc" data-cy="b-graph" data-act="in" title="Zoom in">+</button>
              <button type="button" class="gc" data-cy="b-graph" data-act="out" title="Zoom out">−</button>
              <button type="button" class="gc" data-cy="b-graph" data-act="fit" title="Fit to contents">fit</button>
              <button type="button" class="gc" data-cy="b-graph" data-act="relayout" title="Re-run layout">↻</button>
              <button type="button" class="gc" data-cy="b-graph" data-act="shuffle" title="Different arrangement">⇄</button>
            </div>
            <div id="b-graph" class="graphbox"></div>
          </div>
          <div id="b-results"></div>
        </section>
      </div>
    </div>

    <!-- SIMPLE (search + drill-down) -->
    <div class="panel" id="panel-simple">
      <div class="simple-wrap">
        <div class="simple-box">
          <span class="simple-ico">⌕</span>
          <input type="search" id="s-input" class="simple-search" autocomplete="off"
            placeholder="Search a vuln, capability, or goal — try “rce”, “domain admin”, “ssrf”…" />
        </div>
        <div class="simple-clarify" id="s-clarify" hidden></div>
        <div class="simple-crumbs" id="s-crumbs" hidden></div>
        <div class="simple-results" id="s-results">
          <div class="simple-hint">Type to search 92 techniques, 11 goals, and every capability hand-off. Click a result to drill into what reaches it and where it leads.</div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.2/cytoscape.min.js"></script>
  <script>
    import { forwardReach } from '../lib/query.mjs';
    import { findPaths, findBackward, nodesAchieving } from '../lib/path.mjs';

    const BASE = import.meta.env.BASE_URL;
    let graph = null, capLabel = {}, goalLabel = {}, nodeMeta = {};
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

    // --- graph (cytoscape) ---
    const CAT_COLOR = { web:'#4ea1d3', cloud:'#d9a441', kubernetes:'#56b877', cicd:'#e5484d', llm:'#a06cd5', mobile:'#3fb6b2', network:'#8a93a6', host:'#cf8e6d', 'active-directory':'#e26fb0', start:'#e4e8f0' };
    const GRAPH_STYLE = [
      { selector: 'node', style: {
        'background-color': (el) => CAT_COLOR[el.data('cat')] ?? '#8a93a6',
        'label': 'data(label)', 'color': '#0a0e14', 'font-family': 'JetBrains Mono, monospace',
        'font-size': 13, 'font-weight': 600, 'text-valign': 'center', 'text-halign': 'center',
        'text-wrap': 'wrap', 'text-max-width': 130, 'shape': 'round-rectangle',
        'width': 'label', 'height': 'label', 'padding': 11 } },
      { selector: 'node[goal = 1]', style: { 'border-width': 3, 'border-color': '#e5484d' } },
      { selector: 'node[start = 1]', style: { 'shape': 'ellipse', 'border-width': 2, 'border-color': '#e4e8f0' } },
      { selector: 'node.focus', style: { 'border-width': 4, 'border-color': '#e4e8f0' } },
      { selector: 'node.hl', style: { 'border-width': 3, 'border-color': '#e5484d' } },
      { selector: 'edge.hl', style: { 'line-color': '#e5484d', 'target-arrow-color': '#e5484d', 'width': 2.5, 'line-style': 'solid' } },
      { selector: '.dim', style: { 'opacity': 0.16 } },
      { selector: '.domdim', style: { 'opacity': 0.08 } },
      { selector: 'edge', style: {
        'width': 1.5, 'line-color': '#4a5162', 'target-arrow-color': '#4a5162',
        'target-arrow-shape': 'triangle', 'curve-style': 'bezier', 'arrow-scale': 0.9,
        'label': 'data(via)', 'font-family': 'JetBrains Mono, monospace', 'font-size': 9,
        'color': '#8a93a6', 'text-background-color': '#0f141c', 'text-background-opacity': 0.9,
        'text-background-padding': 2 } },
      { selector: 'edge[curated = 0]', style: { 'line-style': 'dashed', 'line-color': '#333b49', 'target-arrow-color': '#333b49' } },
    ];

    const LAYOUTS = {
      breadthfirst: { name: 'breadthfirst', directed: true, padding: 20, spacingFactor: 1.4 },
      cose: { name: 'cose', padding: 20, animate: false, nodeRepulsion: 13000, idealEdgeLength: 120, nodeOverlap: 24 },
      concentric: { name: 'concentric', padding: 20, minNodeSpacing: 40 },
      circle: { name: 'circle', padding: 20, spacingFactor: 1.3 },
      grid: { name: 'grid', padding: 20, avoidOverlapPadding: 16 },
    };
    const LAYOUT_ORDER = ['breadthfirst', 'cose', 'concentric', 'circle', 'grid'];
    const cyById = {};
    const layoutIdx = {};
    const lastRoots = {};

    // Fit the whole graph into view (the start node stays on screen).
    function fitReadable(cy, eles) {
      cy.fit(eles, 26);
    }

    function runLayout(id) {
      const cy = cyById[id];
      if (!cy || !cy.elements().length) return;
      const name = LAYOUT_ORDER[layoutIdx[id] ?? 0];
      const opts = { ...LAYOUTS[name] };
      if (name === 'breadthfirst' && lastRoots[id]?.length) opts.roots = lastRoots[id];
      cy.layout(opts).run();
      fitReadable(cy);
    }

    function resizeAllGraphs() {
      Object.values(cyById).forEach((cy) => {
        try { cy.resize(); if (cy.elements(':visible').length) cy.fit(undefined, 24); } catch (e) {}
      });
    }
    function toggleFullscreen(wrap) {
      if (!wrap) return;
      if (document.fullscreenElement) { (document.exitFullscreen || document.webkitExitFullscreen)?.call(document); }
      else { (wrap.requestFullscreen || wrap.webkitRequestFullscreen)?.call(wrap); }
    }
    // Is the kept collection a single linear chain (no branching)?
    function isLinearChain(coll) {
      const nodes = coll.nodes();
      if (nodes.length < 2) return false;
      const edges = coll.edges().filter((e) => coll.contains(e.source()) && coll.contains(e.target()));
      if (edges.length !== nodes.length - 1) return false;
      return nodes.every((n) => edges.filter((e) => e.source().id() === n.id() || e.target().id() === n.id()).length <= 2);
    }
    // Order the nodes of a chain from its root along the edges.
    function orderChain(coll) {
      const nodes = coll.nodes();
      const inChain = (e) => coll.contains(e.source()) && coll.contains(e.target());
      const start = nodes.filter((n) => n.incomers('edge').filter(inChain).length === 0);
      let cur = start.length ? start[0] : nodes[0];
      const order = [], seen = new Set();
      while (cur && !seen.has(cur.id())) {
        order.push(cur); seen.add(cur.id());
        const nxt = cur.outgoers('node').filter((n) => coll.contains(n) && !seen.has(n.id()));
        cur = nxt.length ? nxt[0] : null;
      }
      nodes.forEach((n) => { if (!seen.has(n.id())) order.push(n); });
      return order;
    }
    // A straight chain reads better laid out left-to-right (bigger, more readable).
    function layoutHorizontalChain(cy, coll) {
      const order = orderChain(coll);
      const GAP = 210;
      cy.batch(() => order.forEach((n, i) => n.position({ x: i * GAP, y: 0 })));
      fitReadable(cy, coll);
    }

    // --- chain key (top-left live readout of the hovered/selected chain) ---
    function chainKeyHtml(coll) {
      const nodes = coll.nodes();
      const inChain = (e) => coll.contains(e.source()) && coll.contains(e.target());
      const depth = {}; nodes.forEach((n) => { depth[n.id()] = 0; });
      for (let i = 0; i < nodes.length; i++) coll.edges().forEach((e) => {
        if (inChain(e)) depth[e.target().id()] = Math.max(depth[e.target().id()], depth[e.source().id()] + 1);
      });
      const ordered = nodes.sort((a, b) => (depth[a.id()] - depth[b.id()]) || a.data('label').localeCompare(b.data('label')));
      return ordered.map((n) => `<span class="ck-node" style="color:${DOMAIN_COLOR[n.data('cat')] ?? '#8a93a6'}">${esc(n.data('label'))}</span>`).join('<span class="ck-sep">›</span>');
    }
    function showChainKey(id, coll) {
      const box = document.getElementById(id)?.closest('.graphwrap')?.querySelector('.cy-chainkey');
      if (!box) return;
      box.innerHTML = chainKeyHtml(coll);
      box.style.display = 'block';
    }
    function hideChainKey(id) {
      const box = document.getElementById(id)?.closest('.graphwrap')?.querySelector('.cy-chainkey');
      if (box) box.style.display = 'none';
    }
    // Top-left: just the hovered node's title (non-blocking).
    function showNodeKey(id, node) {
      const box = document.getElementById(id)?.closest('.graphwrap')?.querySelector('.cy-nodekey');
      if (!box) return;
      box.innerHTML = `<span class="ck-node" style="color:${DOMAIN_COLOR[node.data('cat')] ?? '#8a93a6'}">${esc(node.data('label'))}</span>`;
      box.style.display = 'block';
    }
    function hideNodeKey(id) {
      const box = document.getElementById(id)?.closest('.graphwrap')?.querySelector('.cy-nodekey');
      if (box) box.style.display = 'none';
    }

    // --- sidebar node-info + pathway list (Phase 2) ---
    const sideId = (graphId, kind) => graphId.replace('-graph', '-' + kind);
    function chipList(arr, labeler, cls) {
      if (!arr || !arr.length) return '<span class="ni-none">—</span>';
      return arr.map((x) => `<span class="chip ${cls}">${esc(labeler(x))}</span>`).join('');
    }
    // Click a node -> brief overview in the left sidebar (stays until another click).
    function showNodeInfo(graphId, slug) {
      const box = document.getElementById(sideId(graphId, 'info'));
      if (!box) return;
      const n = nodeMeta[slug];
      if (!n) { box.hidden = true; return; }
      box.innerHTML =
        `<div class="ni-head"><span class="ni-dot" style="background:${CAT_COLOR[n.category] ?? '#8a93a6'}"></span>`
        + `<span class="ni-name">${esc(n.name)}</span></div>`
        + `<div class="ni-meta"><span class="chip tier-${esc(n.tier)}">${esc(n.tier)}</span><span class="cat">${esc(n.category)}</span>${n.os ? `<span class="cat">${esc(n.os)}</span>` : ''}</div>`
        + `<p class="ni-sum">${esc((n.summary ?? '').trim())}</p>`
        + `<div class="ni-row"><span class="ni-lab">requires</span>${chipList(n.requires, (c) => capLabel[c] ?? c, 'cap')}</div>`
        + `<div class="ni-row"><span class="ni-lab">provides</span>${chipList(n.provides, (c) => capLabel[c] ?? c, 'cap')}</div>`
        + `<div class="ni-row"><span class="ni-lab">achieves</span>${chipList(n.achieves, (g) => goalLabel[g] ?? g, 'goal')}</div>`
        + `<a class="ni-open" href="${BASE}node/${slug}/" target="_blank" rel="noopener">open full page ↗</a>`;
      box.hidden = false;
    }
    function hideNodeInfo(graphId) {
      const box = document.getElementById(sideId(graphId, 'info'));
      if (box) { box.hidden = true; box.innerHTML = ''; }
    }
    // Collapse the forward panel's input sections to free room for the info box.
    function collapseInputs(graphId) {
      const aside = document.getElementById(sideId(graphId, 'controls'));
      if (aside) aside.querySelectorAll('.control-group.collapsible').forEach((g) => g.classList.add('collapsed'));
    }

    // Pathway list: the hovered (preview) or selected (removable) chain, as a list.
    function pathwayItemsHtml(coll, removable) {
      return orderChain(coll).map((n) => {
        const slug = n.id(), nm = nodeMeta[slug];
        const col = CAT_COLOR[nm?.category] ?? '#8a93a6';
        return `<li data-slug="${esc(slug)}"><span class="pw-dot" style="background:${col}"></span>`
          + `<button type="button" class="pw-name">${esc(nm?.name ?? slug)}</button>`
          + (removable ? '<button type="button" class="pw-x" title="Hide this step from the map">✕</button>' : '') + '</li>';
    }).join('');
    }
    function showPathway(graphId, coll, removable) {
      const box = document.getElementById(sideId(graphId, 'pathway'));
      if (!box) return;
      // Drop synthetic start nodes (e.g. the "__held" capabilities root) — real vulns only.
      const real = coll && coll.nodes ? coll.nodes().filter((n) => nodeMeta[n.id()]) : null;
      if (!real || real.length < 1) { box.hidden = true; return; }
      box.innerHTML = `<div class="pw-head">${removable ? 'Selected chain' : 'Chain preview'}`
        + `<span class="pw-count">${real.length}</span></div>`
        + `<ul class="pw-list">${pathwayItemsHtml(real, removable)}</ul>`;
      box.hidden = false;
      const cy = cyById[graphId];
      box.querySelectorAll('.pw-name').forEach((b) => b.addEventListener('click', () => focusNode(graphId, b.closest('li').dataset.slug)));
      box.querySelectorAll('.pw-x').forEach((b) => b.addEventListener('click', () => {
        const slug = b.closest('li').dataset.slug;
        const node = cy.getElementById(slug);
        node.hide(); node.connectedEdges().hide();
        const vis = cy.elements(':visible');
        showPathway(graphId, vis.nodes().length ? vis : null, true);
        if (vis.nodes().length) showChainKey(graphId, vis); else hideChainKey(graphId);
        try { if (vis.nodes().length) cy.fit(vis, 24); } catch (e) {}
      }));
    }
    function hidePathway(graphId) {
      const box = document.getElementById(sideId(graphId, 'pathway'));
      if (box) { box.hidden = true; box.innerHTML = ''; }
    }
    // After a hover preview ends, fall back to the locked selected chain if pruned.
    function restorePathway(graphId) {
      const cy = cyById[graphId];
      if (cy && cy.scratch('_pruned')) showPathway(graphId, cy.elements(':visible'), true);
      else hidePathway(graphId);
    }

    // "Use this exploit path": keep the chosen node + everything up/downstream of it,
    // fade the rest out, then re-run the layout on just the kept chain.
    function pruneToPath(id, nodeId) {
      const cy = cyById[id]; if (!cy) return;
      const node = cy.getElementById(nodeId); if (!node.length) return;
      // Operate on what's currently visible, so the user can prune repeatedly to
      // narrow down (each "use this path" filters within the remaining subset).
      const vis = cy.elements(':visible');
      const keep = node.union(node.successors()).union(node.predecessors()).intersection(vis);
      const drop = vis.not(keep);
      cy.scratch('_pruned', true);
      cy.elements().removeClass('dim hl');
      const wrap = document.getElementById(id)?.closest('.graphwrap');
      const sa = wrap && wrap.querySelector('[data-act=showall]'); if (sa) sa.style.display = 'inline-flex';
      showChainKey(id, keep); // bottom-left: the chain you selected
      showPathway(id, keep, true); // sidebar: the selected chain, each step removable
      if (!drop.length) { fitReadable(cy, keep); return; }
      // Hide the other branches immediately, hold the kept nodes in place for a
      // beat, then re-run the layout so the chosen chain tidies up. A straight
      // chain is laid out horizontally so the boxes can be read without zooming.
      drop.hide();
      cy.fit(keep, 24);
      setTimeout(() => {
        if (isLinearChain(keep)) {
          layoutHorizontalChain(cy, keep);
        } else {
          const roots = keep.nodes().roots();
          keep.layout({ ...LAYOUTS.breadthfirst, roots: roots.length ? roots : undefined, animate: true, animationDuration: 450 }).run();
          setTimeout(() => fitReadable(cy, keep), 480);
