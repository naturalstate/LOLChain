---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found" description="That page does not exist.">
  <div class="wrap">
    <section class="hero">
      <div class="label kicker">404</div>
      <h1 style="font-size:clamp(28px,4.5vw,44px)">No chain leads here.</h1>
      <p>That page doesn't exist. Head back to the catalog or trace a chain.</p>
      <p style="margin-top:18px">
        <a class="btn primary" href={base} style="text-decoration:none;margin-right:10px">Browse vulns</a>
        <a class="btn" href={`${base}query/`} style="text-decoration:none">Query</a>
      </p>
    </section>
  </div>
</Base>
