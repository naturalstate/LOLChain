---
import Base from '../../layouts/Base.astro';
import { buildGraph } from '../../lib/graph.mjs';

export function getStaticPaths() {
  const { nodes, edges, capabilities, goals } = buildGraph();
  const capLabel = Object.fromEntries(capabilities.map((c) => [c.slug, c.label]));
  const goalLabel = Object.fromEntries(goals.map((g) => [g.slug, g.label]));
  const nodeName = Object.fromEntries(nodes.map((n) => [n.slug, n.name]));
  const nodeCat = Object.fromEntries(nodes.map((n) => [n.slug, n.category]));

  return nodes.map((node) => ({
    params: { slug: node.slug },
    props: {
      node,
      capLabel,
      goalLabel,
      nodeName,
      nodeCat,
      outgoing: edges.filter((e) => e.from === node.slug),
      incoming: edges.filter((e) => e.to === node.slug),
    },
  }));
}

const base = import.meta.env.BASE_URL;
const { node, capLabel, goalLabel, nodeName, nodeCat, outgoing, incoming } = Astro.props;
const cap = (s) => capLabel[s] ?? s;

const curatedOut = outgoing.filter((e) => e.type === 'curated');
const derivedOut = outgoing.filter((e) => e.type === 'derived');
const curatedIn = incoming.filter((e) => e.type === 'curated');
const srcHref = `https://github.com/`; // repo URL set when hosting is chosen

// --- 1-hop mini-diagram (predecessors -> this node -> successors) ---
const CAT_COLOR = { web: '#4ea1d3', cloud: '#d9a441', kubernetes: '#56b877', cicd: '#e5484d', llm: '#a06cd5', mobile: '#3fb6b2', network: '#8a93a6', host: '#cf8e6d', 'active-directory': '#e26fb0' };
const catColor = (c) => CAT_COLOR[c] ?? '#8a93a6';
function neighbors(edges, key) {
  const m = new Map();
  for (const e of edges) {
    const slug = e[key];
    if (!m.has(slug)) m.set(slug, { slug, name: nodeName[slug] ?? slug, cat: nodeCat[slug], via: new Set(), curated: false });
    const o = m.get(slug);
    (e.via ?? []).forEach((v) => o.via.add(cap(v)));
    if (e.type === 'curated') o.curated = true;
  }
  return [...m.values()].sort((a, b) => Number(b.curated) - Number(a.curated) || a.name.localeCompare(b.name));
}
const MM_MAX = 6;
const predsAll = neighbors(incoming, 'from');
const succsAll = neighbors(outgoing, 'to');
const preds = predsAll.slice(0, MM_MAX);
const succs = succsAll.slice(0, MM_MAX);
---
<Base title={node.name} description={node.summary}>
  <div class="wrap">
    <div class="crumb"><a href={base}>LolChain</a> / {node.slug.toUpperCase()}</div>

    <div class="node-head">
      <div>
        <h1>{node.name}</h1>
        <div class="badges">
          <span class={`chip tier-${node.tier}`}>{node.tier}</span>
          <span class="chip">{node.category}</span>
          <span class="chip">{curatedOut.length} documented chain{curatedOut.length === 1 ? '' : 's'}</span>
          {node.mitre?.map((m) => <span class="chip cap">{m}</span>)}
        </div>
      </div>
      <a class="viewsrc" href={`${srcHref}`} target="_blank" rel="noopener">⌁ {node.slug}.yml</a>
    </div>

    <div class="minimap" aria-label="Chain neighbourhood — click a step to walk to it">
      <div class="mm-zone">
        <div class="mm-ztitle">↑ reached by</div>
        {preds.length ? preds.map((p) => (
          <a class="mm-card" href={`${base}node/${p.slug}/`}>
            <span class="mm-row"><span class="mm-dot" style={`background:${catColor(p.cat)}`}></span><span class="mm-name">{p.name}</span></span>
            <span class="mm-via">{[...p.via].join(', ')}</span>
          </a>
        )) : <div class="mm-stub">entry point</div>}
        {predsAll.length > MM_MAX && <div class="mm-more">+{predsAll.length - MM_MAX} more below</div>}
      </div>

      <div class="mm-arrow" aria-hidden="true">→</div>

      <div class="mm-node">
        <span class="mm-row"><span class="mm-dot" style={`background:${catColor(node.category)}`}></span><span class="mm-name">{node.name}</span></span>
        {node.achieves?.length > 0 && <span class="mm-goal">⚑ {node.achieves.map((g) => goalLabel[g] ?? g).join(', ')}</span>}
      </div>

      <div class="mm-arrow" aria-hidden="true">→</div>

      <div class="mm-zone">
        <div class="mm-ztitle">↓ leads to</div>
        {succs.length ? succs.map((s) => (
          <a class="mm-card" href={`${base}node/${s.slug}/`}>
            <span class="mm-row"><span class="mm-dot" style={`background:${catColor(s.cat)}`}></span><span class="mm-name">{s.name}</span></span>
            <span class="mm-via">{[...s.via].join(', ')}</span>
          </a>
        )) : <div class="mm-stub">{node.achieves?.length ? 'goal reached' : 'terminal'}</div>}
        {succsAll.length > MM_MAX && <div class="mm-more">+{succsAll.length - MM_MAX} more below</div>}
      </div>
    </div>

    <div class="detail">
      <aside class="side">
        {curatedOut.length > 0 && (
          <>
            <h3>Chains from here</h3>
            <div class="side-list">
              {curatedOut.map((e) => (
                <a class="side-item" href={`${base}node/${e.to}/`}>{nodeName[e.to] ?? e.to}</a>
              ))}
            </div>
          </>
        )}
        {node.references?.length > 0 && (
          <>
            <h3>References</h3>
            <div class="side-list">
              {node.references.map((r) => (
                <a class="side-item" href={r.url} target="_blank" rel="noopener">{r.title ?? r.url} ↗</a>
              ))}
            </div>
          </>
        )}
      </aside>

      <section>
        <p style="font-size:16px;color:var(--text);max-width:68ch;">{node.summary}</p>

        <div class="section-title">Capabilities</div>
        <div class="card">
          <div class="field">
            <span class="k">Requires</span>
            <span class="v cap-cell">
              {node.requires.length
                ? node.requires.map((r) => <span class="chip cap">{cap(r)}</span>)
                : <span style="color:var(--text-dim)">entry point — no prior capability</span>}
            </span>
          </div>
          <div class="field">
            <span class="k">Provides</span>
            <span class="v cap-cell">{node.provides.map((pv) => <span class="chip provides">{cap(pv)}</span>)}</span>
          </div>
          {node.achieves?.length > 0 && (
            <div class="field">
              <span class="k">Achieves</span>
              <span class="v cap-cell">{node.achieves.map((g) => <span class="chip goal">{goalLabel[g] ?? g}</span>)}</span>
            </div>
          )}
        </div>

        {(curatedOut.length > 0 || derivedOut.length > 0) && (
          <>
            <div class="section-title">Chains from here</div>
            {curatedOut.map((e) => (
              <div class="card">
                <h2><a href={`${base}node/${e.to}/`}>{nodeName[e.to] ?? e.to}</a></h2>
                <div class="via">
                  <span class="label" style="align-self:center">via</span>
                  {e.via.map((v) => <span class="chip cap">{cap(v)}</span>)}
                  {e.documented && <span class="chip doc">documented</span>}
                  {e.difficulty && <span class="chip">{e.difficulty}</span>}
                </div>
                <p>{e.outcome}</p>
                {e.references?.length > 0 && (
                  <div class="field">
                    <span class="k">References</span>
                    <span class="v"><ul>{e.references.map((r) => <li><a href={r} target="_blank" rel="noopener">{r} ↗</a></li>)}</ul></span>
                  </div>
                )}
              </div>
            ))}
            {derivedOut.map((e) => (
              <div class="card derived">
                <h2><a href={`${base}node/${e.to}/`}>{nodeName[e.to] ?? e.to}</a></h2>
                <div class="via">
                  <span class="label" style="align-self:center">via</span>
                  {e.via.map((v) => <span class="chip cap">{cap(v)}</span>)}
                  <span class="chip derived">derived · unverified</span>
                </div>
                <p style="color:var(--text-dim)">
                  Plausible handoff: this node provides a capability the target requires.
                  Not a documented chain — verify before relying on it.
                </p>
              </div>
            ))}
          </>
        )}

        {curatedIn.length > 0 && (
          <>
            <div class="section-title">Reaches this node</div>
            <div class="card" style="border-left-color:var(--border-strong)">
              <div class="via">
                {curatedIn.map((e) => <a class="chip" href={`${base}node/${e.from}/`}>{nodeName[e.from] ?? e.from}</a>)}
              </div>
            </div>
          </>
        )}

        <div class="section-title">Defense</div>
        <div class="card" style="border-left-color:var(--accent-4)">
          {node.detection && (
            <div class="field"><span class="k">Detection</span><span class="v">{node.detection}</span></div>
          )}
          {node.remediation && (
            <div class="field"><span class="k">Remediation</span><span class="v">{node.remediation}</span></div>
          )}
          {node.mitre?.length > 0 && (
            <div class="field"><span class="k">MITRE ATT&CK</span><span class="v">{node.mitre.join(', ')}</span></div>
          )}
        </div>
      </section>
    </div>
  </div>
</Base>
