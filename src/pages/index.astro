---
import Base from '../layouts/Base.astro';
import { buildGraph } from '../lib/graph.mjs';

const base = import.meta.env.BASE_URL;
const { stats } = buildGraph();

const modes = [
  { tag: 'I have X', q: '“I’ve got a foothold on X (or hold capability C) — now what?”',
    a: 'Forward reachability: every vuln those capabilities unlock, hop by hop, with the linking capability and the goals reached.' },
  { tag: 'X → goal Z', q: '“From X, how do I reach goal Z?” (optionally through node Y)',
    a: 'Ranked paths — documented first, then fully-curated, then shorter, then easier.' },
  { tag: 'I want Z', q: '“I want to achieve Z — what gives it?”',
    a: 'Backward search: every vuln that achieves Z and the entry paths that reach each one.' },
];

const incidents = [
  'Capital One — SSRF → IMDS → S3',
  'Log4Shell — JNDI → RCE / IMDS',
  'MOVEit — SQLi → webshell → blob keys',
  'Uber 2022 — MFA fatigue → PAM vault',
  'SolarWinds — build implant → signed backdoor',
  'Scattered Spider — vishing → internal access',
  'Citrix Bleed — token leak → past MFA',
  'Ransomware — cred dumping → AD takeover',
];

const desc = 'Living Off the Land, for vulnerability chains — a queryable graph of exploit-chain capability handoffs.';
---
<Base title="LolChain" description={desc}>
  <div class="wrap">
    <section class="hero landing-hero">
      <div class="label kicker">Exploit-chain reference</div>
      <h1>Living Off the Land,<br />for vulnerability chains.</h1>
      <p class="lede">
        The LoL sites catalog single primitives. Real breaches are <em>chains</em> &mdash; a
        &ldquo;boring&rdquo; SSRF becomes cloud credentials becomes an IAM-admin role becomes
        a data breach. LolChain catalogs the chains and makes them queryable. Every vuln is a
        handoff: it <em>requires</em> capabilities and <em>provides</em> others, and an edge
        exists wherever one node&rsquo;s output satisfies the next node&rsquo;s input.
      </p>
      <div class="cta-row">
        <a class="btn primary" href={`${base}query/`}>&rarr; I have X, what can I chain into?</a>
        <a class="btn" href={`${base}browse/`}>Browse the catalog</a>
      </div>
      <div class="stat-strip">
        <span><b>{stats.nodeCount}</b> vulns</span>
        <span><b>{stats.chainCount}</b> curated chains</span>
        <span><b>{stats.derivedCount}</b> derived candidates</span>
        <span><b>{stats.categoryCount}</b> categories</span>
      </div>
    </section>

    <div class="authnote">
      <b>Authorized use only.</b> A conceptual reference &mdash; the handoff, its outcome,
      detection, and remediation, <em>not</em> copy-paste exploit code. Use the ideas only
      against systems you are authorized to test. <a href={`${base}scope/`}>Scope &amp; ethics &rarr;</a>
    </div>

    <section class="land-sec">
      <h2>The on-the-fly chain map</h2>
      <p class="land-sub">
        Pick a foothold and LolChain walks the capability graph, drawing every path it
        unlocks &mdash; rendered live in the browser. One low-severity SSRF, three critical goals.
      </p>
      <figure class="land-fig">
        <img src={`${base}images/chain-map.svg`} alt="On-the-fly chain map: SSRF branching across cloud, network and kubernetes to three goals" loading="lazy" />
        <figcaption>
          Nodes colored by category; <b>solid edges are curated</b> (cited), <b>dashed edges
          are derived</b> (inferred from capability overlap &mdash; plausible, unverified);
          <b>red-bordered nodes are goals</b>. Every edge is labeled with the capability that
          links the two steps.
        </figcaption>
      </figure>
    </section>

    <section class="land-sec">
      <h2>Three ways to query</h2>
      <figure class="land-fig">
        <img src={`${base}images/query-modes.svg`} alt="Three query modes: I have X, X to goal Z, I want Z" loading="lazy" />
      </figure>
      <div class="mode-cards">
        {modes.map((m) => (
          <a class="mode-card" href={`${base}query/`}>
            <div class="mc-tag">{m.tag}</div>
            <div class="mc-q">{m.q}</div>
            <div class="mc-a">{m.a}</div>
          </a>
        ))}
      </div>
      <p class="land-sub">All three run <b>client-side</b> over a single <code>graph.json</code> &mdash; no backend, no telemetry.</p>
    </section>

    <section class="land-sec">
      <h2>Grounded in real incidents</h2>
      <p class="land-sub">
        Many chains are modelled directly on public breach post-mortems and vendor research
        &mdash; each node cites its sources, and references are never invented.
      </p>
      <div class="inc-chips">
        {incidents.map((i) => <span class="inc-chip">{i}</span>)}
      </div>
      <p class="land-sub" style="margin-top:14px"><a href={`${base}about/`}>How the model works, in full &rarr;</a></p>
    </section>
  </div>
</Base>
